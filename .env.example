# Grok HMS Environment Configuration
# Copy this to .env.local and fill in values

# Database - SQLite for development, PostgreSQL for production
DATABASE_URL="file:./prisma/dev.db"
# For production: DATABASE_URL="postgresql://user:password@localhost:5432/grok_hms?schema=public"

# JWT Authentication
JWT_SECRET="CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_IN_PRODUCTION_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Session & CSRF
SESSION_SECRET="ANOTHER_VERY_STRONG_RANDOM_SECRET_FOR_SESSIONS"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Integrations (Phase 3+)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=